---
/** Lumen's mark: the launcher icon's accent dot, three list bars and index bracket (app/src/main/res/drawable). */
interface Props {
  size?: number;
  plate?: boolean;
}
const { size = 28, plate = false } = Astro.props;
---
<svg width={size} height={size} viewBox={plate ? "0 0 48 48" : "4.3 6.3 35 35"} aria-hidden="true" class="mark">
  {plate && <rect width="48" height="48" rx="11" fill="#000000" />}
  <circle cx="11.5" cy="11.5" r="4.3" fill="var(--accent, #ee8031)" />
  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="4.2">
    <line x1="10" y1="21" x2="24" y2="21" stroke-opacity="0.5" />
    <line x1="10" y1="29" x2="21" y2="29" stroke-opacity="0.75" />
    <line x1="10" y1="37" x2="23" y2="37" stroke-opacity="0.5" />
  </g>
  <path d="M35 9 L35 22.5 C35 25.5 29.5 26 29.5 29 C29.5 32 35 32.5 35 35.5 L35 39" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
</svg>
