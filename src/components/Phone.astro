---
/**
 * A drawn miniature of Lumen's "Essential" style (Look.Essential): the Flow wallpaper in Orange,
 * the two-tone Classic clock, lowercase favorites with dots, and the A–Z index on the edge,
 * which waves under the pointer like the real one.
 */
import type { Lang } from "../i18n/site";

interface Props {
  lang: Lang;
  label: string;
  favorites: string[];
}
const { lang, label, favorites } = Astro.props;
const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
---
<figure class="phone" role="img" aria-label={label} data-lang={lang}>
  <div class="screen">
    <canvas class="wall" aria-hidden="true"></canvas>
    <div class="clock" aria-hidden="true">
      <span class="hh">09</span><span class="sep">:</span><span class="mm">41</span>
    </div>
    <div class="date" aria-hidden="true"></div>
    <ul class="favs" aria-hidden="true">
      {favorites.map((name) => <li>{name}</li>)}
    </ul>
    <ol class="index" aria-hidden="true">
      <li class="glyph">♥</li>
      {letters.map((l) => <li>{l}</li>)}
      <li class="glyph">⚙</li>
      <li class="glyph">⌕</li>
    </ol>
  </div>
</figure>

<script>
  /** Mulberry32: a small seeded random, so the wallpaper is the same picture on every visit. */
  function seeded(seed: number) {
    return () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  /**
   * The app's Flow wallpaper (core/wallpaper WallpaperPainter.flow), dark, in Orange: hundreds of
   * fine lines drifting along an invisible current, brighter lower down, adding up where they cross.
   */
  function drawFlow(canvas: HTMLCanvasElement) {
    const ratio = Math.min(devicePixelRatio || 1, 2);
    const w = Math.round(canvas.clientWidth * ratio);
    const h = Math.round(canvas.clientHeight * ratio);
    if (!w || !h) return;
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext("2d")!;
    const random = seeded(1859);
    const u = w / 1080;
    const deep = [56, 30, 6]; // HSV(accent hue, 0.9 sat, 0.22 value), as WallpaperPalette.deep
    const accent = [255, 122, 0];
    const frequency = [0, 1, 2].map(() => 2.5 + random() * 3.5);
    const phase = [0, 1, 2].map(() => random() * 2 * Math.PI);
    const direction = (x: number, y: number) => {
      const nx = x / w;
      const ny = y / w;
      return Math.PI * (
        Math.sin(nx * frequency[0] + phase[0]) * Math.cos(ny * frequency[1] + phase[1]) +
        0.6 * Math.sin((nx - ny) * frequency[2] + phase[2])
      );
    };
    ctx.fillStyle = "#000";
    ctx.fillRect(0, 0, w, h);
    ctx.globalCompositeOperation = "lighter";
    // A touch thicker than on a phone, so the hairlines survive the miniature's size.
    ctx.lineWidth = 1.5 * u * 1.6;
    ctx.lineJoin = "round";
    const step = 5 * u;
    for (let line = 0; line < 650; line++) {
      let x = random() * w;
      let y = random() * h;
      const height = y / h;
      const tone = 0.35 + 0.65 * random();
      const c = deep.map((d, i) => Math.round(d + (accent[i] - d) * tone));
      ctx.strokeStyle = `rgba(${c[0]},${c[1]},${c[2]},${0.1 + 0.4 * height})`;
      ctx.beginPath();
      ctx.moveTo(x, y);
      for (let i = 0; i < 80; i++) {
        const angle = direction(x, y);
        x += Math.cos(angle) * step;
        y += Math.sin(angle) * step;
        ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
    ctx.globalCompositeOperation = "source-over";
  }

  for (const phone of document.querySelectorAll<HTMLElement>(".phone")) {
    const wall = phone.querySelector<HTMLCanvasElement>(".wall")!;
    drawFlow(wall);
    new ResizeObserver(() => {
      if (Math.round(wall.clientWidth * Math.min(devicePixelRatio || 1, 2)) !== wall.width) drawFlow(wall);
    }).observe(wall);

    const lang = phone.dataset.lang ?? "en";
    const hh = phone.querySelector(".hh")!;
    const mm = phone.querySelector(".mm")!;
    const date = phone.querySelector(".date")!;
    const tick = () => {
      const now = new Date();
      hh.textContent = String(now.getHours()).padStart(2, "0");
      mm.textContent = String(now.getMinutes()).padStart(2, "0");
      date.textContent = new Intl.DateTimeFormat(lang, { weekday: "long", day: "numeric", month: "long" })
        .format(now)
        .toLowerCase();
    };
    tick();
    setInterval(tick, 15_000);

    // The wave: letters near the finger slide out and grow, the one under it takes the accent.
    const index = phone.querySelector<HTMLElement>(".index")!;
    const items = [...index.querySelectorAll<HTMLElement>("li")];
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wave = (y: number | null) => {
      let nearest: HTMLElement | null = null;
      let best = Infinity;
      for (const item of items) {
        const box = item.getBoundingClientRect();
        const d = y === null ? Infinity : Math.abs(box.top + box.height / 2 - y);
        if (d < best) { best = d; nearest = item; }
        const pull = y === null || still ? 0 : Math.max(0, 1 - d / 70);
        item.style.transform = `translateX(${-pull * 26}px) scale(${1 + pull * 0.9})`;
      }
      for (const item of items) item.classList.toggle("on", y !== null && item === nearest);
    };
    const move = (e: PointerEvent) => wave(e.clientY);
    index.addEventListener("pointerdown", (e) => { index.setPointerCapture(e.pointerId); move(e); });
    index.addEventListener("pointermove", move);
    for (const end of ["pointerup", "pointercancel", "pointerleave"]) {
      index.addEventListener(end, () => wave(null));
    }
  }
</script>
